vars: {
  d2-config: {
    sketch: true
    theme-id: 0
    layout-engine: elk
    pad: 30
  }
}

direction: right

classes: {
  box: {
    style: {
      fill: "#e7f5ff"
      stroke: "#1971c2"
      stroke-width: 2
      font-color: "#1e1e1e"
      border-radius: 4
    }
  }
  accent: {
    style: {
      fill: "#fff3bf"
      stroke: "#f08c00"
      stroke-width: 2
      font-color: "#1e1e1e"
      border-radius: 4
    }
  }
  good: {
    style: {
      fill: "#d3f9d8"
      stroke: "#2f9e44"
      stroke-width: 2
      font-color: "#1e1e1e"
      border-radius: 4
    }
  }
  arrow: {
    style: {
      stroke: "#1e1e1e"
      stroke-width: 2
      font-color: "#1e1e1e"
    }
  }
}
