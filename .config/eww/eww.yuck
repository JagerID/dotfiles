(defpoll time :interval "1s" "date '+%H:%M'")
(defpoll battery :interval "15s" "cat /sys/class/power_supply/BAT1/capacity")
(defpoll charge :interval "15s" "cat /sys/class/power_supply/BAT1/status")

(defwidget v-separator []
	(box :class "v-separator"))

(defwidget power []
	(box :class "power"
		(label :text "${battery}%")))

(defwidget time []
	(box :class "time"
		(label :text time)))

(defwidget cpu []
	(box :class "cpu"
		(label :text "CPU: ${round(EWW_CPU.avg, 0)}%")))

(defwidget ram []
	   (box :class "ram"
		:space-evenly false
		:spacing 0
		(label :text "RAM: ${round(EWW_RAM.used_mem_perc, 0)}%")))

(defwindow island [x y w h anch mon content]
	:monitor mon
	:geometry (geometry :x x
			    :y y
			    :width w
			    :height h
			    :anchor anch)
	:stacking "overlay"
	:exclusive false
	(box :class "island" :valign "center" :halign "center"
	     (literal :content content)))
